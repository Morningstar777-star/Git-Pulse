# ==============================================================================
# GITPULSE EXPLORER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# [Optional] GitHub Personal Access Token (Classic or Fine-grained)
# Providing a token increases your GitHub API rate limit from 60 to 5,000 requests/hour.
# If left blank, GitPulse Explorer operates cleanly on unauthenticated rate limits
# and pre-seeded multi-day snapshot baselines without crashing.
GITHUB_TOKEN=

# Background Crawler Refresh Interval in minutes (default: 60)
REFRESH_INTERVAL_MINUTES=60

# Local SQLite Database Path
# DB_PATH=data/gitpulse.db

# Server Host and Port
HOST=127.0.0.1
PORT=8000
